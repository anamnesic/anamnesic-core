{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kairos/workspace",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "bun --cwd terminal run typecheck",
    "typecheck:web": "bun --cwd web/app run typecheck",
    "test": "bun --cwd terminal run test",
    "test:ci": "bun --cwd terminal run test:ci",
    "build": "bun --cwd terminal run build",
    "dev": "bun --cwd terminal run dev",
    "dev:web": "bun --cwd web/app run dev",
    "db": "bun --cwd terminal run db",
    "fix-node-pty": "bun --cwd terminal run fix-node-pty",
    "upgrade-opentui": "bun --cwd terminal run upgrade-opentui"
  },
  "devDependencies": {
    "@effect/language-service": "0.84.2"
  }
}
